{
  "name": "road-rash-bharat",
  "private": true,
  "version": "0.3.0",
  "description": "Street bike combat racing through Indian cities. A pseudo-3D arcade racer in the Road Rash tradition.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "gate": "node .ironclad/gate.mjs --stage packet",
    "qa": "node scripts/qa.mjs",
    "qa:ui": "node scripts/qa-ui.mjs",
    "icons": "node scripts/icons.mjs",
    "qa:campaign": "node scripts/qa-campaign.mjs",
    "balance": "vite-node scripts/balance.ts",
    "record": "node scripts/record.mjs",
    "perf": "node scripts/perf.mjs",
    "qa:circuits": "node scripts/qa-circuits.mjs",
    "assets": "node scripts/gen-assets.mjs",
    "assets:compress": "node scripts/compress-assets.mjs"
  },
  "keywords": [
    "game",
    "racing",
    "canvas",
    "pseudo-3d",
    "webaudio",
    "pwa"
  ],
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
