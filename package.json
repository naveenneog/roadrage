{
  "name": "road-rash-bharat",
  "private": true,
  "version": "0.1.0",
  "description": "Street bike combat racing through Indian cities. A pseudo-3D arcade racer in the Road Rash tradition.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "gate": "node .ironclad/gate.mjs --stage packet",
    "qa": "node scripts/qa.mjs"
  },
  "keywords": [
    "game",
    "racing",
    "canvas",
    "pseudo-3d",
    "webaudio",
    "pwa"
  ],
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
